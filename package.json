{
  "name": "dboard",
  "version": "1.2.0",
  "private": true,
  "warnings": [
    "Setting NODE_TLS_REJECT_UNAUTHORIZED to '0' makes TLS connections and HTTPS requests insecure by disabling certificate verification.",
    "This should only be used in a trusted local development environment.",
    "Do not use this setting in production environments as it exposes the application to security vulnerabilities."
  ],
  "scripts": {
    "cz": "cz",
    "warning": "echo 'WARNING: Setting NODE_TLS_REJECT_UNAUTHORIZED to '0' makes TLS connections and HTTPS requests insecure by disabling certificate verification. This should only be used in a trusted local development environment. Do not use this setting in production environments as it exposes the application to security vulnerabilities.'",
    "warnings": "echo 'REPEAT ------------ ' && pnpm run warning",
    "dev": "sudo NODE_TLS_REJECT_UNAUTHORIZED=0 vite dev --config vite.config.dev.ts --host --port 443",
    "start": "sudo NODE_TLS_REJECT_UNAUTHORIZED=0 PORT=443 HOST=dboard.server node server.js",
    "build": "NODE_TLS_REJECT_UNAUTHORIZED=0 HOST=dboard.server PORT=443 vite build --config vite.config.prod.ts",
    "build.dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 HOST=dboard.server PORT=443 vite build --config vite.config.dev.ts --mode development",
    "build.test": "vite build --config vite.config.test.ts",
    "preview": "NODE_TLS_REJECT_UNAUTHORIZED=0 vite preview --config vite.config.prod.ts --host --port 443",
    "preview.test": "vite preview --config vite.config.test.ts --host",
    "test": "pnpm run test:integration && pnpm run test:unit",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check.watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "lint.watch": "pnpm lint || chokidar \"src/**/*.{js,ts,svelte,json}\" -c \"pnpm lint || true\"",
    "watch": "chokidar \"src/**/*.{js,ts,svelte,json}\" -c \"prettier --check {path} && eslint {path}\" --initial",
    "format": "prettier --write .",
    "sync": "svelte-kit sync",
    "test.integration": "playwright test",
    "test.unit": "vitest",
    "trash": "rm -rf .svelte-kit build",
    "prepare": "husky",
    "release": "standard-version --no-verify",
    "reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm i",
    "chokidar": "chokidar-cli"
  },
  "standard-version": {
    "tagPrefix": ""
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "*.json": [
      "prettier --write",
      "git add"
    ],
    "*.md": [
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "bits-ui": "^0.21.16",
    "canvas": "^2.11.2",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "fast-average-color": "^9.4.0",
    "lucide-svelte": "^0.469.0",
    "standard-version": "^9.5.0",
    "tailwind-merge": "^2.5.5",
    "tailwind-variants": "^0.3.0",
    "ws": "^8.18.0",
    "xmldom": "^0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@iconify/svelte": "^4.1.0",
    "@playwright/test": "^1.49.1",
    "@sveltejs/adapter-node": "^5.2.11",
    "@sveltejs/kit": "^2.13.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/cors": "^2.8.17",
    "@types/echarts": "^4.9.22",
    "@types/eslint": "^9.6.1",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "chokidar-cli": "^3.0.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^16.4.7",
    "echarts": "^5.5.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "i": "^0.3.7",
    "lint-staged": "^15.2.11",
    "nanoid": "^5.0.9",
    "postcss": "^8.4.49",
    "postcss-color-function": "^4.1.0",
    "postcss-load-config": "^6.0.1",
    "postcss-mixins": "^11.0.3",
    "prettier": "^3.4.2",
    "prettier-plugin-css-order": "^2.1.2",
    "prettier-plugin-svelte": "^3.3.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "svelte": "5.15.0",
    "svelte-awesome-color-picker": "^3.1.4",
    "svelte-check": "^4.1.1",
    "svelte-grid": "^5.1.2",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^2.1.8"
  },
  "type": "module"
}
